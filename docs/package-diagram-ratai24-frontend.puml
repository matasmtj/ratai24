@startuml ratai24-packages-frontend
title Ratai24 — Frontend (Boundaries + ClientIntegration)

skinparam packageStyle rectangle

package "Ratai24.Frontend" as FE {

  package "Boundaries" as B {

    package "Public.ViewPages" as BPub {
      class HomePage <<Boundary>>
      class CarsPage <<Boundary>>
      class CarDetailPage <<Boundary>>
      class CarSalePage <<Boundary>>
      class ContactsPage <<Boundary>>
      note right: PartsPage, PartDetailPage, CarSaleDetailPage, ...
    }

    package "Auth.ViewPages" as BAuth {
      class LoginPage <<Boundary>>
      class RegisterPage <<Boundary>>
      class ForgotPasswordPage <<Boundary>>
      class ResetPasswordPage <<Boundary>>
    }

    package "User.ViewPages" as BUser {
      class UserDashboard <<Boundary>>
      class UserProfilePage <<Boundary>>
    }

    package "Admin.ViewPages" as BAdm {
      class AdminDashboard <<Boundary>>
      class AdminCarsPage <<Boundary>>
      class AdminContractsPage <<Boundary>>
      class AdminUsersPage <<Boundary>>
      class AdminCitiesPage <<Boundary>>
      class AdminPartsPage <<Boundary>>
      class AdminContactsPage <<Boundary>>
      class AdminPricingDashboard <<Boundary>>
      class AdminPricingRulesPage <<Boundary>>
      class AdminSeasonalFactorsPage <<Boundary>>
    }

    package "Legal.ViewPages" as BLegal {
      class RentalTermsPage <<Boundary>>
      class PrivacyPolicyPage <<Boundary>>
    }

    package "Boundaries.Components" as BComp {
      class Layout <<Boundary>>
      class PricePreviewWidget <<Boundary>>
      class PriceBreakdown <<Boundary>>
      class LoyaltyBadge <<Boundary>>
      class CarImagesManager <<Boundary>>
      note bottom: PaginationBar, DateRangePicker, ...
    }
  }

  package "ClientIntegration" as CI {

    package "HttpClient" as HC {
      class ApiClient <<Gateway>>
      note bottom: Axios instancija (pvz. lib/api.ts)
    }

    package "ApiGateways" as GW {
      class authApi <<Gateway>>
      class carsApi <<Gateway>>
      class citiesApi <<Gateway>>
      class contractsApi <<Gateway>>
      class usersApi <<Gateway>>
      class contactsApi <<Gateway>>
      class partsApi <<Gateway>>
      class pricingApi <<Gateway>>
      note bottom
        partsApi — UI modulis; Prisma gali neturėti atskiros Part lentelės
        (diagramoje palikti su pastaba „API sluoksnis“).
      end note
    }

    package "ClientState" as CS {
      class ReactQueryCache <<optional>>
      note bottom
        @tanstack/react-query — cache / useQuery
        (ryšį į CS gali nebraižyti, kad grafas liktų paprastesnis).
      end note
    }
  }
}

BPub ..> GW
BAuth ..> GW
BUser ..> GW
BAdm ..> GW
BLegal ..> GW
BComp ..> GW
GW ..> HC

@enduml
